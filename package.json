{
  "name": "nextplay-api",
  "version": "0.1.0",
  "private": true,
  "description": "Serverless soccer team analytics API (AWS Lambda + API Gateway + Cognito + Aurora Postgres)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts",
    "import:spreadsheet": "ts-node scripts/import-spreadsheet.ts",
    "docs:build": "ts-node scripts/build-openapi.ts",
    "offline": "serverless offline",
    "deploy": "serverless deploy"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.716.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "yaml": "^2.9.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.146",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "esbuild": "^0.24.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "serverless": "^3.40.0",
    "serverless-esbuild": "^1.55.0",
    "serverless-offline": "^12.0.4",
    "serverless-prune-plugin": "^2.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  }
}
