# Local development (docker-compose Postgres). Port 5433 is used instead of the
# default 5432 to avoid colliding with any Postgres already running on the host.
DATABASE_URL="postgresql://nextplay:nextplay@localhost:5433/nextplay?schema=public"

# Deployed environments should point at the RDS Proxy endpoint, not the
# Aurora cluster endpoint directly, and keep the Prisma-side pool tiny since
# the proxy handles multiplexing:
# DATABASE_URL="postgresql://nextplay:<password>@<rds-proxy-endpoint>:5432/nextplay?schema=public&connection_limit=1&pool_timeout=0"

AWS_REGION="us-west-2"

# Cognito (filled in after `serverless deploy` creates the User Pool / Client,
# or after you create them manually for local-only auth testing)
COGNITO_USER_POOL_ID=""
COGNITO_USER_POOL_CLIENT_ID=""
